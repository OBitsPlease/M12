<Window x:Class="MultibandCore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MultibandCore"
        Title="BitsPleaseYT M12 | 12-Band Compressor"
        Width="1500" Height="960" MinWidth="1420" MinHeight="900"
        Background="#101216" Foreground="#E8EAF0" FontFamily="Bahnschrift"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#202329"/>
        <SolidColorBrush x:Key="ControlBrush" Color="#2B2F37"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F25FCA"/>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#090A0C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#626873"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#090A0C" BorderBrush="#626873" BorderThickness="1" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="8,4" VerticalAlignment="Center"
                                                                  Content="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1" Width="8" Height="5" Stretch="Fill" Fill="#D9DCE1"
                                                      Data="M 0 0 L 8 0 L 4 5 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="320" Background="#090A0C" BorderBrush="#626873" BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.72"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#090A0C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#343942"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#4A3146"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#090A0C"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#626873"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#30343D"/>
            <Setter Property="Foreground" Value="#F4F5F8"/>
            <Setter Property="BorderBrush" Value="#505661"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Background" Value="#292D34"/>
            <Setter Property="Foreground" Value="#BFC4CE"/>
            <Setter Property="BorderBrush" Value="#484E59"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#F25FCA"/>
                    <Setter Property="Foreground" Value="#16171B"/>
                    <Setter Property="BorderBrush" Value="#FFB4EA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" SnapsToDevicePixels="True">
                            <Border Height="7" VerticalAlignment="Center" CornerRadius="3"
                                    BorderBrush="#15171B" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#171A1F" Offset="0"/>
                                        <GradientStop Color="#464B54" Offset="0.45"/>
                                        <GradientStop Color="#24272D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.65" Color="#000000"/>
                                </Border.Effect>
                            </Border>
                            <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="15" Height="17" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Border CornerRadius="3" BorderBrush="#F8F9FA" BorderThickness="1">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                                <GradientStop Color="#D9DCE1" Offset="0.42"/>
                                                                <GradientStop Color="#9DA3AC" Offset="0.72"/>
                                                                <GradientStop Color="#EEF0F3" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="2" Opacity="0.75" Color="#000000"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Border Width="7" Height="2" CornerRadius="1" Background="#39D968" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#A8D72E"/>
            <Setter Property="Background" Value="#111318"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="255"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="112"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                <TextBlock Text="BitsPleaseYT M12" FontSize="25" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                <TextBlock Text="12-BAND MULTIBAND COMPRESSOR" FontSize="10" Foreground="#F25FCA"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="SOURCE" Foreground="#AEB4BF" FontSize="10" Margin="2,0,0,3"/>
                <ComboBox x:Name="InputDeviceBox" ToolTip="Audio source: playback, microphone, line input, or external sound card"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="TO" Foreground="#747B88" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                <TextBlock Text="PROCESSED OUTPUT" Foreground="#AEB4BF" FontSize="10" Margin="2,0,0,3"/>
                <ComboBox x:Name="OutputDeviceBox" ToolTip="Processed audio destination: speakers, headphones, or external sound card"/>
            </StackPanel>
            <Button Grid.Column="4" Content="REFRESH" Margin="0,0,8,0" Click="RefreshDevices_Click"/>
            <Button x:Name="StartButton" Grid.Column="5" Content="START AUDIO" Background="#A8D72E" Foreground="#111318" FontWeight="SemiBold" Click="StartButton_Click"/>
            <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="15,0,0,0">
                <Ellipse x:Name="StatusLight" Width="10" Height="10" Fill="#555A64" Margin="0,0,7,0"/>
                <TextBlock x:Name="StatusText" Text="IDLE" Foreground="#9CA2AD" FontSize="11"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>
            <Border Background="#111317" BorderBrush="#3D424B" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                <local:CompressorGraph x:Name="ResponseGraph"/>
            </Border>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Crossovers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,5">
                            <local:RotaryKnob Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Step="5"
                                              Value="{Binding Frequency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              ValueFormat="0 Hz" Foreground="#CED2D9" Cursor="SizeAll"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Grid.Row="2" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="118"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#181B20" BorderBrush="#4B515B" BorderThickness="1" CornerRadius="5" Margin="3,0" Padding="7,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="GLOBAL" FontSize="15" FontWeight="SemiBold" Foreground="#74E062" HorizontalAlignment="Center"/>
                        <TextBlock Text="ALL BANDS" Foreground="#9299A5" FontSize="9" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <UniformGrid Grid.Row="1" Rows="6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="THRESH" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center"/>
                            <local:RotaryKnob x:Name="GlobalThresholdKnob" Grid.Column="1" Tag="Threshold" Minimum="-30" Maximum="30" Step="0.5" Value="0" ValueFormat="+0.0;-0.0;0.0 dB" Foreground="#DDE1E7" Cursor="SizeAll" ValueChanged="GlobalControl_Changed" ToolTip="Global threshold trim for all bands"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="RATIO" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center"/>
                            <local:RotaryKnob x:Name="GlobalRatioKnob" Grid.Column="1" Tag="Ratio" Minimum="-9.5" Maximum="9.5" Step="0.1" Value="0" ValueFormat="+0.0;-0.0;0.0" Foreground="#DDE1E7" Cursor="SizeAll" ValueChanged="GlobalControl_Changed" ToolTip="Global ratio trim for all bands"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="RANGE" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center"/>
                            <local:RotaryKnob x:Name="GlobalRangeKnob" Grid.Column="1" Tag="Range" Minimum="-15" Maximum="15" Step="0.5" Value="0" ValueFormat="+0.0;-0.0;0.0 dB" Foreground="#DDE1E7" Cursor="SizeAll" ValueChanged="GlobalControl_Changed" ToolTip="Global range trim for all bands"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="GAIN" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center"/>
                            <local:RotaryKnob x:Name="GlobalGainKnob" Grid.Column="1" Tag="MakeupGain" Minimum="-12" Maximum="12" Step="0.5" Value="0" ValueFormat="+0.0;-0.0;0.0 dB" Foreground="#DDE1E7" Cursor="SizeAll" ValueChanged="GlobalControl_Changed" ToolTip="Global makeup gain trim for all bands"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="ATTACK" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center"/>
                            <local:RotaryKnob x:Name="GlobalAttackKnob" Grid.Column="1" Tag="Attack" Minimum="-49.75" Maximum="49.75" Step="0.5" Value="0" ValueFormat="+0.0;-0.0;0.0 ms" Foreground="#DDE1E7" Cursor="SizeAll" ValueChanged="GlobalControl_Changed" ToolTip="Global attack trim for all bands"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="RELEASE" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center"/>
                            <local:RotaryKnob x:Name="GlobalReleaseKnob" Grid.Column="1" Tag="Release" Minimum="-490" Maximum="490" Step="5" Value="0" ValueFormat="+0;-0;0 ms" Foreground="#DDE1E7" Cursor="SizeAll" ValueChanged="GlobalControl_Changed" ToolTip="Global release trim for all bands"/>
                        </Grid>
                    </UniformGrid>
                </Grid>
            </Border>

            <ItemsControl Grid.Column="1" ItemsSource="{Binding Bands}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Rows="2" Columns="6"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="#3D424B" BorderThickness="1" CornerRadius="5" Margin="3,0" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Color}"/>
                                <TextBlock Text="{Binding FrequencyLabel}" Foreground="#9299A5" FontSize="10"/>
                            </StackPanel>
                            <ProgressBar Grid.Row="1" Height="6" Minimum="0" Maximum="30" Value="{Binding GainReduction}" Foreground="{Binding Color}"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,5">
                                <ToggleButton Content="S" IsChecked="{Binding IsSolo}" Width="32" Margin="0,0,5,0" ToolTip="Solo this band"/>
                                <ToggleButton Content="BYP" IsChecked="{Binding IsBypassed}" Width="46" ToolTip="Bypass compression for this band"/>
                                <TextBlock Text="{Binding GainReduction, StringFormat={}{0:F1} dB GR}" Foreground="#AEB4BE" FontSize="10" Margin="8,0,0,0"/>
                            </StackPanel>
                            <UniformGrid Grid.Row="3" Rows="2" Columns="3">
                                <Grid>
                                    <TextBlock Text="THRESH" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <local:RotaryKnob Minimum="-60" Maximum="0" Step="0.5" Value="{Binding Threshold, Mode=TwoWay}" ValueFormat="0.0 dB" Foreground="#DDE1E7" Cursor="SizeAll" Margin="0,8,0,0"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="RATIO" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <local:RotaryKnob Minimum="1" Maximum="20" Step="0.1" Value="{Binding Ratio, Mode=TwoWay}" ValueFormat="0.0:1" Foreground="#DDE1E7" Cursor="SizeAll" Margin="0,8,0,0"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="RANGE" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <local:RotaryKnob Minimum="0" Maximum="30" Step="0.5" Value="{Binding Range, Mode=TwoWay}" ValueFormat="0.0 dB" Foreground="#DDE1E7" Cursor="SizeAll" Margin="0,8,0,0"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="GAIN" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <local:RotaryKnob Minimum="-12" Maximum="12" Step="0.5" Value="{Binding MakeupGain, Mode=TwoWay}" ValueFormat="+0.0;-0.0;0.0 dB" Foreground="#DDE1E7" Cursor="SizeAll" Margin="0,8,0,0"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="ATTACK" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <local:RotaryKnob Minimum="0.5" Maximum="100" Step="0.5" Value="{Binding Attack, Mode=TwoWay}" ValueFormat="0.0 ms" Foreground="#DDE1E7" Cursor="SizeAll" Margin="0,8,0,0"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="RELEASE" FontSize="9" Foreground="#BCC1CA" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <local:RotaryKnob Minimum="20" Maximum="1000" Step="5" Value="{Binding Release, Mode=TwoWay}" ValueFormat="0 ms" Foreground="#DDE1E7" Cursor="SizeAll" Margin="0,8,0,0"/>
                                </Grid>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Border Grid.Row="3" Background="#1B1E23" BorderBrush="#3D424B" BorderThickness="1" CornerRadius="5" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PRESET" Foreground="#8F96A2" FontSize="10"/>
                    <ComboBox x:Name="PresetBox" ItemsSource="{Binding PresetNames}" SelectionChanged="PresetBox_SelectionChanged"/>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PresetNameBox" MinHeight="28" Padding="7,4" ToolTip="Name for this compressor preset"/>
                        <Button Grid.Column="1" Content="SAVE" Padding="8,4" Margin="5,0,0,0" Click="SavePreset_Click" ToolTip="Save all current compressor settings"/>
                        <Button Grid.Column="2" Content="DELETE" Padding="8,4" Margin="5,0,0,0" Click="DeletePreset_Click" ToolTip="Delete the selected user preset"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0">
                    <TextBlock Text="BEHAVIOR" Foreground="#8F96A2" FontSize="10"/>
                    <ComboBox x:Name="BehaviorBox" SelectionChanged="BehaviorBox_SelectionChanged">
                        <ComboBoxItem Content="Clean" IsSelected="True"/>
                        <ComboBoxItem Content="Opto"/>
                        <ComboBoxItem Content="Punch"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="8,0">
                    <TextBlock Text="KNEE" Foreground="#8F96A2" FontSize="10"/>
                    <TextBlock Text="{Binding ElementName=KneeSlider, Path=Value, StringFormat={}{0:F1} dB}"/>
                    <Slider x:Name="KneeSlider" Minimum="0" Maximum="18" Value="6" ValueChanged="MasterControl_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="8,0">
                    <TextBlock Text="OUTPUT" Foreground="#8F96A2" FontSize="10"/>
                    <TextBlock Text="{Binding ElementName=OutputSlider, Path=Value, StringFormat={}{0:F1} dB}"/>
                    <Slider x:Name="OutputSlider" Minimum="-18" Maximum="12" Value="0" ValueChanged="MasterControl_Changed"/>
                </StackPanel>
                <CheckBox x:Name="AutoReleaseCheck" Grid.Column="4" Content="AUTO RELEASE" IsChecked="True" VerticalAlignment="Center" Checked="MasterControl_Changed" Unchecked="MasterControl_Changed"/>
                <Grid Grid.Column="5" Margin="20,0,0,0">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="IN" Foreground="#9299A5" FontSize="10"/>
                    <ProgressBar x:Name="InputMeter" Grid.Column="1" Minimum="-60" Maximum="0" Value="-60" Height="10"/>
                    <TextBlock Grid.Row="1" Text="OUT" Foreground="#9299A5" FontSize="10"/>
                    <ProgressBar x:Name="OutputMeter" Grid.Row="1" Grid.Column="1" Minimum="-60" Maximum="0" Value="-60" Height="10" Foreground="#F25FCA"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
